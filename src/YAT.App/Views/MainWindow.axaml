<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:YAT.app.ViewModels"
        xmlns:entities="using:YAT.Domain.Entities"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
        x:Class="YAT.app.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Width="1100" Height="700"
        Title="YAT">

    <!-- The runtime DataContext is built by CompositionRoot with real Application handlers (see App.axaml.cs). -->

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="E_xit" Click="OnExitClick" />
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="_Project Panel"
                          ToggleType="CheckBox"
                          IsChecked="{Binding IsProjectPanelVisible, Mode=OneWay}"
                          Command="{Binding ToggleProjectPanelCommand}" />
            </MenuItem>
        </Menu>

        <Border DockPanel.Dock="Top"
                Padding="12,6"
                BorderThickness="0,1"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="No Project"
                           Opacity="0.6"
                           IsVisible="{Binding !HasCurrentProject}" />
                <TextBlock Text="{Binding CurrentProject.Name, FallbackValue={x:Null}}"
                           FontWeight="SemiBold"
                           IsVisible="{Binding HasCurrentProject}" />
                <TextBlock Text="›"
                           Opacity="0.6"
                           IsVisible="{Binding SelectedWorksheet, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <TextBlock Text="{Binding SelectedWorksheet.Name, FallbackValue={x:Null}}"
                           IsVisible="{Binding SelectedWorksheet, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>
        </Border>

        <!-- Outside the Project Panel so errors stay visible while the panel is hidden. -->
        <Border DockPanel.Dock="Top"
                Padding="12,4"
                Background="#1AD13438"
                IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="#D13438"
                       TextWrapping="Wrap" />
        </Border>

        <Grid ColumnDefinitions="Auto,*">
            <Border Grid.Column="0"
                    Width="300"
                    BorderThickness="0,0,1,0"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                    IsVisible="{Binding IsProjectPanelVisible}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="12,8,4,0">
                        <TextBlock Text="Project"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1"
                                Content="×"
                                ToolTip.Tip="Hide Project Panel"
                                Background="Transparent"
                                Command="{Binding ToggleProjectPanelCommand}" />
                    </Grid>

                    <ScrollViewer>
                        <StackPanel Margin="12" Spacing="16">
                            <StackPanel Spacing="6">
                                <TextBlock Text="New Project" FontWeight="SemiBold" />
                                <TextBox Text="{Binding ProjectName}" PlaceholderText="Project name" />
                                <TextBox Text="{Binding ProjectDescription}" PlaceholderText="Description (optional)" />
                                <Button Content="Create Project"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center"
                                        Command="{Binding CreateProjectCommand}" />
                            </StackPanel>

                            <StackPanel Spacing="6">
                                <TextBlock Text="Current Project" FontWeight="SemiBold" />
                                <TextBlock Text="No Project yet."
                                           Opacity="0.6"
                                           IsVisible="{Binding !HasCurrentProject}" />
                                <TextBlock Text="{Binding CurrentProject.Name, FallbackValue={x:Null}}"
                                           TextWrapping="Wrap"
                                           IsVisible="{Binding HasCurrentProject}" />
                                <TextBlock Text="{Binding CurrentProject.Description, FallbackValue={x:Null}}"
                                           Opacity="0.7"
                                           TextWrapping="Wrap"
                                           IsVisible="{Binding CurrentProject.Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}, FallbackValue=False}" />
                            </StackPanel>

                            <StackPanel Spacing="6">
                                <TextBlock Text="Worksheets" FontWeight="SemiBold" />
                                <TextBox Text="{Binding WorksheetName}"
                                         PlaceholderText="Worksheet name"
                                         IsEnabled="{Binding HasCurrentProject}" />
                                <Button Content="Create Worksheet"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center"
                                        Command="{Binding CreateWorksheetCommand}" />
                                <ListBox ItemsSource="{Binding Worksheets}"
                                         SelectedItem="{Binding SelectedWorksheet}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="entities:Worksheet">
                                            <TextBlock Text="{Binding Name}" />
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <Panel Grid.Column="1">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="6"
                            IsVisible="{Binding SelectedWorksheet, Converter={x:Static ObjectConverters.IsNull}}">
                    <TextBlock Text="Worksheet workspace"
                               FontSize="20"
                               Opacity="0.5"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="No Worksheet selected"
                               Opacity="0.5"
                               HorizontalAlignment="Center" />
                </StackPanel>

                <DockPanel Margin="24,16"
                           IsVisible="{Binding SelectedWorksheet, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <StackPanel DockPanel.Dock="Top" Spacing="2">
                        <TextBlock FontSize="20" FontWeight="SemiBold">
                            <Run Text="Worksheet:" />
                            <Run Text="{Binding SelectedWorksheet.Name, FallbackValue={x:Null}}" />
                        </TextBlock>
                        <TextBlock Opacity="0.6" Text="{Binding SelectedWorksheetSummary}" />
                        <TextBlock Text="Pasting…"
                                   Opacity="0.6"
                                   IsVisible="{Binding IsPasteInProgress}" />
                    </StackPanel>

                    <Panel>
                        <!-- Empty Worksheet: data is expected to arrive by pasting from Excel, not manual schema entry. -->
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="6"
                                    IsVisible="{Binding !HasGridColumns}">
                            <TextBlock Text="Paste data from Excel to begin"
                                       FontSize="18"
                                       Opacity="0.7"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="Copy cells including the header row, then press Ctrl+V"
                                       FontSize="12"
                                       Opacity="0.5"
                                       HorizontalAlignment="Center" />
                        </StackPanel>

                        <!-- Read-only worksheet grid: one page of rows. Its columns are built from GridColumns in
                             code-behind. Clicking a column header selects it as the Ctrl+V paste target. -->
                        <DockPanel Margin="0,12,0,0"
                                   IsVisible="{Binding HasGridColumns}">
                            <Grid DockPanel.Dock="Top"
                                  Margin="0,0,0,6"
                                  ColumnDefinitions="*,Auto,Auto,Auto">
                                <TextBlock Grid.Column="0"
                                           VerticalAlignment="Center"
                                           FontSize="12"
                                           Opacity="0.5"
                                           TextWrapping="Wrap"
                                           Text="Click a column header to paste into that column; with no column selected, Ctrl+V appends new columns." />
                                <Button Grid.Column="1"
                                        Content="Previous"
                                        Command="{Binding PreviousPageCommand}" />
                                <TextBlock Grid.Column="2"
                                           Margin="12,0"
                                           VerticalAlignment="Center"
                                           Text="{Binding GridPageSummary}" />
                                <Button Grid.Column="3"
                                        Content="Next"
                                        Command="{Binding NextPageCommand}" />
                            </Grid>

                            <TableView x:Name="WorksheetGrid"
                                       ItemsSource="{Binding GridRows}"
                                       CanUserResizeColumns="True" />
                        </DockPanel>
                    </Panel>
                </DockPanel>
            </Panel>
        </Grid>
    </DockPanel>

</Window>
