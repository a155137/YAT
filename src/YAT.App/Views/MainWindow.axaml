<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:YAT.app.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
        x:Class="YAT.app.Views.MainWindow"
        x:DataType="vm:MainWindowShellViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Width="1100" Height="700"
        Title="{Binding WindowTitle}">

    <!-- The runtime DataContext (the shell: File menu and window title around the current project's view model) is built by
         CompositionRoot with real Application handlers (see App.axaml.cs). Project-specific content binds to Project,
         which is replaced when another project is shown. -->

    <!-- File shortcuts. TextBoxes do not use these gestures, so text editing keeps its own keys. -->
    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+N" Command="{Binding NewProjectCommand}" />
        <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenProjectCommand}" />
        <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding SaveAsCommand}" />
    </Window.KeyBindings>

    <Window.Resources>
        <ResourceDictionary>
            <!-- Cells of selected worksheet columns (active included): the default cell theme plus a light accent tint.
                 Assigned per column as TableViewColumn.CellTheme by the window (see WorksheetGridLayout.ApplyColumnState). -->
            <ControlTheme x:Key="SelectedWorksheetCellTheme"
                          TargetType="TableViewCell"
                          BasedOn="{StaticResource {x:Type TableViewCell}}">
                <Setter Property="Background">
                    <SolidColorBrush Color="{DynamicResource SystemAccentColor}" Opacity="0.10" />
                </Setter>
            </ControlTheme>

            <!-- Project Explorer glyphs (16×16, drawn in the icon's theme foreground): a folder and a table with a header row. -->
            <StreamGeometry x:Key="ProjectExplorerProjectIcon">M1,3 L6,3 L7.5,4.5 L15,4.5 L15,13.5 L1,13.5 Z</StreamGeometry>
            <StreamGeometry x:Key="ProjectExplorerWorksheetIcon">F0 M1,2 L15,2 L15,14 L1,14 Z M2,5.5 L7.5,5.5 L7.5,9 L2,9 Z M8.5,5.5 L14,5.5 L14,9 L8.5,9 Z M2,10 L7.5,10 L7.5,13 L2,13 Z M8.5,10 L14,10 L14,13 L8.5,13 Z</StreamGeometry>

            <!-- Icon of the active worksheet: the accent color, lightened on dark backgrounds to keep its contrast. -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="ProjectExplorerActiveIconBrush" Color="{DynamicResource SystemAccentColor}" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="ProjectExplorerActiveIconBrush" Color="{DynamicResource SystemAccentColorLight2}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- Compact tree rows. -->
            <x:Double x:Key="TreeViewItemMinHeight">24</x:Double>
        </ResourceDictionary>
    </Window.Resources>

    <Window.Styles>
        <!-- Worksheet grid density: TableView's Fluent defaults are list-sized; the grid uses compact rows and headers. -->
        <Style Selector="TableView#WorksheetGrid">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAltHighBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <!-- The header strip's padding (6,9,6,12) is fixed in the TableView template; cancel it so headers line up
             with the cells and the strip is only as tall as the headers. -->
        <Style Selector="TableView#WorksheetGrid TableViewColumnHeadersPresenter">
            <Setter Property="Margin" Value="-6,-9,-6,-12" />
        </Style>
        <Style Selector="TableView#WorksheetGrid TableViewRow">
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
        </Style>
        <!-- Spreadsheet grid lines: each cell draws its right and bottom edge (headers do the same in WorksheetGridLayout). -->
        <Style Selector="TableView#WorksheetGrid TableViewCell">
            <Setter Property="Padding" Value="6,2,6,1" />
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
        </Style>
        <Style Selector="TableView#WorksheetGrid TableViewColumnHeader">
            <Setter Property="Padding" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>
        <!-- Header content (incl. the selection highlight) is styled in WorksheetGridLayout: window styles do not reach it. -->

        <!-- Project Explorer: hover and selection use the Fluent TreeViewItem theme brushes (light and dark). The active
             worksheet is also marked by a semibold name and an accent icon, so it stays visible when the selection moves
             to the project item. -->
        <Style Selector="TreeView#ProjectExplorerTree">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="0,2" />
        </Style>
        <Style Selector="TreeView#ProjectExplorerTree TreeViewItem" x:DataType="vm:ProjectExplorerItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
        </Style>
        <Style Selector="TreeView#ProjectExplorerTree PathIcon.yat-explorer-icon">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Opacity" Value="0.75" />
        </Style>
        <Style Selector="TreeView#ProjectExplorerTree PathIcon.yat-explorer-icon.active">
            <Setter Property="Foreground" Value="{DynamicResource ProjectExplorerActiveIconBrush}" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="TreeView#ProjectExplorerTree TextBlock.active">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <!-- Inline rename editor: sized like the name it replaces. -->
        <Style Selector="TreeView#ProjectExplorerTree TextBox.yat-explorer-editor">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="MinWidth" Value="120" />
            <Setter Property="Padding" Value="4,1" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="Button.yat-pager">
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="MinHeight" Value="0" />
        </Style>
    </Window.Styles>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_New Project" InputGesture="Ctrl+N" Command="{Binding NewProjectCommand}" />
                <MenuItem Header="_Open Project..." InputGesture="Ctrl+O" Command="{Binding OpenProjectCommand}" />
                <Separator />
                <MenuItem Header="_Save" InputGesture="Ctrl+S" Command="{Binding SaveCommand}" />
                <MenuItem Header="Save _As..." InputGesture="Ctrl+Shift+S" Command="{Binding SaveAsCommand}" />
                <Separator />
                <!-- Closes the window: the same close path (and save prompt) as the title bar. -->
                <MenuItem Header="E_xit" Click="OnExitClick" />
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="_Project Explorer"
                          ToggleType="CheckBox"
                          IsChecked="{Binding Project.IsProjectPanelVisible, Mode=OneWay, FallbackValue=True}"
                          Command="{Binding Project.ToggleProjectPanelCommand, FallbackValue={x:Null}}" />
            </MenuItem>
        </Menu>

        <Border DockPanel.Dock="Top"
                DataContext="{Binding Project}"
                x:DataType="vm:MainWindowViewModel"
                Padding="12,6"
                BorderThickness="0,1"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="No Project"
                           Opacity="0.6"
                           IsVisible="{Binding !HasCurrentProject}" />
                <TextBlock Text="{Binding CurrentProject.Name, FallbackValue={x:Null}}"
                           FontWeight="SemiBold"
                           IsVisible="{Binding HasCurrentProject}" />
                <TextBlock Text="›"
                           Opacity="0.6"
                           IsVisible="{Binding SelectedWorksheet, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <TextBlock Text="{Binding SelectedWorksheet.Name, FallbackValue={x:Null}}"
                           IsVisible="{Binding SelectedWorksheet, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>
        </Border>

        <!-- Outside the Project Explorer so errors stay visible while the panel is hidden. -->
        <Border DockPanel.Dock="Top"
                DataContext="{Binding Project}"
                x:DataType="vm:MainWindowViewModel"
                Padding="12,4"
                Background="#1AD13438"
                IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="#D13438"
                       TextWrapping="Wrap" />
        </Border>

        <!-- Project Explorer | splitter | worksheet workspace. The explorer column width is user-resizable; while the
             explorer is hidden the window collapses that column (see MainWindow.ApplyProjectExplorerVisibility). -->
        <Grid x:Name="WorkspaceGrid"
              DataContext="{Binding Project}"
              x:DataType="vm:MainWindowViewModel">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" MinWidth="140" MaxWidth="600" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    BorderThickness="0,0,1,0"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                    IsVisible="{Binding IsProjectPanelVisible}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="10,4,4,2">
                        <TextBlock Text="Project Explorer"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Opacity="0.8"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1"
                                Content="×"
                                Padding="6,0"
                                ToolTip.Tip="Hide Project Explorer"
                                Background="Transparent"
                                Command="{Binding ToggleProjectPanelCommand}" />
                    </Grid>

                    <TextBlock DockPanel.Dock="Top"
                               Margin="12,4"
                               Text="No Project"
                               Opacity="0.6"
                               IsVisible="{Binding !HasCurrentProject}" />

                    <!-- Navigation only: items are Project / Worksheet metadata. Selecting a worksheet shows it; double-clicking a name
                         renames it inline (Enter or focus loss commits, Esc cancels). -->
                    <TreeView x:Name="ProjectExplorerTree"
                              ItemsSource="{Binding ProjectExplorer.Items}"
                              SelectedItem="{Binding ProjectExplorer.SelectedItem, Mode=TwoWay}">
                        <TreeView.DataTemplates>
                            <TreeDataTemplate DataType="vm:ProjectExplorerProjectItem" ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal" Spacing="6" Background="Transparent">
                                    <StackPanel.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="New Worksheet" Command="{Binding NewWorksheetCommand}" />
                                        </ContextMenu>
                                    </StackPanel.ContextMenu>
                                    <PathIcon Classes="yat-explorer-icon" Data="{StaticResource ProjectExplorerProjectIcon}" />
                                    <Panel>
                                        <TextBlock Text="{Binding Name}"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   IsVisible="{Binding !IsEditing}"
                                                   DoubleTapped="OnExplorerNameDoubleTapped" />
                                        <TextBox Classes="yat-explorer-editor"
                                                 Text="{Binding EditName}"
                                                 IsVisible="{Binding IsEditing}"
                                                 KeyDown="OnExplorerEditorKeyDown"
                                                 LostFocus="OnExplorerEditorLostFocus" />
                                    </Panel>
                                </StackPanel>
                            </TreeDataTemplate>
                            <DataTemplate DataType="vm:ProjectExplorerWorksheetItem">
                                <StackPanel Orientation="Horizontal" Spacing="6" Background="Transparent">
                                    <PathIcon Classes="yat-explorer-icon" Classes.active="{Binding IsActive}"
                                              Data="{StaticResource ProjectExplorerWorksheetIcon}" />
                                    <Panel>
                                        <TextBlock Classes.active="{Binding IsActive}"
                                                   Text="{Binding Name}"
                                                   VerticalAlignment="Center"
                                                   IsVisible="{Binding !IsEditing}"
                                                   DoubleTapped="OnExplorerNameDoubleTapped" />
                                        <TextBox Classes="yat-explorer-editor"
                                                 Text="{Binding EditName}"
                                                 IsVisible="{Binding IsEditing}"
                                                 KeyDown="OnExplorerEditorKeyDown"
                                                 LostFocus="OnExplorerEditorLostFocus" />
                                    </Panel>
                                </StackPanel>
                            </DataTemplate>
                        </TreeView.DataTemplates>
                    </TreeView>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1"
                          Width="4"
                          ResizeDirection="Columns"
                          Background="Transparent"
                          IsVisible="{Binding IsProjectPanelVisible}" />

            <Panel Grid.Column="2">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="6"
                            IsVisible="{Binding SelectedWorksheet, Converter={x:Static ObjectConverters.IsNull}}">
                    <TextBlock Text="Worksheet workspace"
                               FontSize="20"
                               Opacity="0.5"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="No Worksheet selected"
                               Opacity="0.5"
                               HorizontalAlignment="Center" />
                </StackPanel>

                <DockPanel Margin="8,6,8,8"
                           IsVisible="{Binding SelectedWorksheet, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <!-- One compact bar: worksheet name, summary and paste progress on the left; paging on the right. -->
                    <Grid x:Name="WorksheetHeader"
                          DockPanel.Dock="Top"
                          Margin="0,0,0,6"
                          ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto">
                        <TextBlock Grid.Column="0"
                                   VerticalAlignment="Center"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Text="{Binding SelectedWorksheet.Name, FallbackValue={x:Null}}" />
                        <TextBlock Grid.Column="1"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   Opacity="0.6"
                                   Text="{Binding SelectedWorksheetSummary}" />
                        <TextBlock Grid.Column="2"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   Opacity="0.6"
                                   Text="Pasting…"
                                   IsVisible="{Binding IsPasteInProgress}" />
                        <Button Grid.Column="4"
                                Classes="yat-pager"
                                Content="Previous"
                                IsVisible="{Binding HasGridColumns}"
                                Command="{Binding PreviousPageCommand}" />
                        <TextBlock Grid.Column="5"
                                   Margin="8,0"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   Text="{Binding GridPageSummary}"
                                   IsVisible="{Binding HasGridColumns}" />
                        <Button Grid.Column="6"
                                Classes="yat-pager"
                                Content="Next"
                                IsVisible="{Binding HasGridColumns}"
                                Command="{Binding NextPageCommand}" />
                    </Grid>

                    <Panel>
                        <!-- Empty Worksheet: data is expected to arrive by pasting from Excel, not manual schema entry. -->
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="6"
                                    IsVisible="{Binding !HasGridColumns}">
                            <TextBlock Text="Paste data from Excel to begin"
                                       FontSize="18"
                                       Opacity="0.7"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="Copy cells including the header row, then press Ctrl+V"
                                       FontSize="12"
                                       Opacity="0.5"
                                       HorizontalAlignment="Center" />
                        </StackPanel>

                        <!-- Read-only worksheet grid: one page of rows. Its columns are built from GridColumns in
                             code-behind. Clicking a column header selects it as the Ctrl+V paste target. -->
                        <TableView x:Name="WorksheetGrid"
                                   ItemsSource="{Binding GridRows}"
                                   CanUserResizeColumns="True"
                                   IsVisible="{Binding HasGridColumns}"
                                   ToolTip.Tip="Click a column header to paste into that column. With no column selected, Ctrl+V appends new columns." />
                    </Panel>
                </DockPanel>
            </Panel>
        </Grid>
    </DockPanel>

</Window>
