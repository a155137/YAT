<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <!--
    The release identity, in one place (Task #048). Version is the only version source: the SDK derives AssemblyVersion
    and FileVersion (<Version>.0) and InformationalVersion (<Version>+<commit>) from it, the About dialog reads them
    from the assembly, and build/publish.ps1 asks MSBuild for it to name the release.
  -->
  <PropertyGroup>
    <Version>0.2.0</Version>
    <Product>YAT</Product>
    <Description>YuXiang Analysis Tool</Description>
    <!-- What Windows shows as the file description of YAT.exe and of every YAT assembly. -->
    <AssemblyTitle>YuXiang Analysis Tool</AssemblyTitle>
    <Company>YX Studio</Company>
    <Copyright>Copyright © 2026 YX Studio</Copyright>
  </PropertyGroup>

  <!--
    Where YAT reads its update information (Task #051.B): the one place the address is written. YAT.App carries it as
    assembly metadata; nothing else names it. Override with -p:YatUpdateManifestUrl=<https address> (for example to try
    a test release).
  -->
  <PropertyGroup>
    <YatUpdateManifestUrl Condition="'$(YatUpdateManifestUrl)' == ''">https://github.com/a155137/YAT/releases/latest/download/yat-update.json</YatUpdateManifestUrl>
  </PropertyGroup>

  <!--
    V1 runtime support is Windows x64. Only executables that consume native dependencies (DuckDB, SkiaSharp)
    target a runtime identifier, so they do not copy native payloads for every platform. Libraries and pure
    test projects stay RID-neutral. Override with -p:YatRuntimeIdentifier=<rid>.
  -->
  <PropertyGroup>
    <YatRuntimeIdentifier Condition="'$(YatRuntimeIdentifier)' == ''">win-x64</YatRuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(MSBuildProjectName)' == 'YAT.App' Or '$(MSBuildProjectName)' == 'YAT.App.Tests' Or '$(MSBuildProjectName)' == 'YAT.Infrastructure.Tests'">$(YatRuntimeIdentifier)</RuntimeIdentifier>
  </PropertyGroup>
</Project>
